# Copy to .env and fill in. Never commit .env.

# Plaid (https://dashboard.plaid.com/developers/keys). Use sandbox until Phase 6.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# AES-GCM key for Plaid access tokens at rest: 32 random bytes, base64.
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# Claude API key for transaction categorization (Phase 4).
ANTHROPIC_API_KEY=

# bcrypt hash of the login password. Leave empty for local dev (no auth).
# Required for any deployment reachable from the internet (Phase 6).
APP_PASSWORD_HASH=

# Postgres password used by docker compose (local only).
DB_PASSWORD=finance
