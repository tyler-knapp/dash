# Copy to .env and fill in. Never commit .env.

# Plaid (https://dashboard.plaid.com/developers/keys). Use sandbox until Phase 6.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# OAuth banks (Phase 6): your Tailscale HTTPS address + /oauth-return, also registered in the Plaid dashboard.
PLAID_REDIRECT_URI=

# AES-GCM key for Plaid access tokens at rest: 32 random bytes, base64.
#   openssl rand -base64 32
TOKEN_ENC_KEY=

# Claude API key for transaction categorization (Phase 4). Optional: without it, the app uses
# rules, transfer detection and Plaid's categories, and flags unclear ones for review.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_SERVER_FALLBACKS=true

# bcrypt hash of the login password. Leave empty for local dev (no auth).
# Required for any deployment reachable from the internet (Phase 6).
APP_PASSWORD_HASH=

# Background sync (defaults shown). Cron is Spring format, in America/New_York.
# SYNC_SCHEDULER_ENABLED=true
# SYNC_CRON=0 0 */6 * * *

# Dev sample data (reference/sample-data), on by default in docker compose. Set false to start empty.
# Removed automatically when the first real institution is linked.
# SAMPLE_DATA=true

# Postgres password used by docker compose (local only).
DB_PASSWORD=finance
